#include <stdio.h>

int main(){
	
	int a;
	int b;
	int soma, sub, mult, divisao;
	
	printf("coloque um valor ao a:");
	scanf("%d", &a);
	
	printf("coloque um valor ao b:");
	scanf("%d", &b);
	
	//soma
	soma = a + b ;
	
	//subtração
	sub = a - b ;
	
	//multriplicação
	mult = a * b ;
	
	//divisão
	divisao = a / b ;
	
	
	printf("o resultado da soma:%d\n", soma);
	printf("o resultado da subtração:%d\n", sub);
	printf("o resultado da multriplicação:%d\n", mult);
	printf("o resultado da divisão:%d\n", divisao);
	
	
}

#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int sortearNumero() {
    return rand() % 100 + 1;
}

int main() {

    int numero;
    int palpite;
    int tentativas = 0;

    srand(time(NULL));

    numero = sortearNumero();

    palpite = 0;

    while (palpite != numero) {

        printf("Digite um numero de 1 a 100: ");
        scanf("%d", &palpite);

        while (palpite < 1 || palpite > 100) {
            printf("Numero invalido!\n");
            printf("Digite novamente: ");
            scanf("%d", &palpite);
        }

        tentativas++;

        if (palpite < numero) {
            printf("Voce chutou muito baixo!\n");
        }
        else if (palpite > numero) {
            printf("Voce chutou muito alto!\n");
        }
        else {
            printf("Parabens!!! Voce acertou!\n");
        }
    }

    printf("Tentativas: %d\n", tentativas);

    return 0;
}
